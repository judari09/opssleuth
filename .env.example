# Copia este archivo a .env y completa los valores. No se versiona (ver .gitignore).

# Proveedor de modelo de chat: "claude" (por defecto), "ollama" o "gemini".
OPSSLEUTH_LLM_PROVIDER=claude

# Requerido si OPSSLEUTH_LLM_PROVIDER=claude (o usa `ant auth login`).
ANTHROPIC_API_KEY=

# Requerido si OPSSLEUTH_LLM_PROVIDER=ollama: nombre de un modelo ya
# descargado localmente (ollama pull <modelo>).
OPSSLEUTH_OLLAMA_MODEL=

# Requerido si OPSSLEUTH_LLM_PROVIDER=gemini: API key de Google AI Studio
# (capa gratuita disponible). El modelo usado es fijo (gemini-3.6-flash, ver
# MODELO_GEMINI_POR_DEFECTO en src/opssleuth/llm/factory.py).
GOOGLE_API_KEY=
